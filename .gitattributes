# 统一换行符：仓库内一律 LF，避免 Windows / Linux 协作时整文件 diff
* text=auto

# 脚本必须按平台换行，否则 git bash 里跑不起来
gradlew          text eol=lf
*.sh             text eol=lf
gradlew.bat      text eol=crlf
*.bat            text eol=crlf

# 源码 / 配置
*.java           text eol=lf
*.kt             text eol=lf
*.kts            text eol=lf
*.gradle         text eol=lf
*.properties     text eol=lf
*.toml           text eol=lf
*.xml            text eol=lf
*.json           text eol=lf
*.pro            text eol=lf
*.keep           text eol=lf
*.md             text eol=lf

# 二进制：不做换行转换、不做文本 diff
*.png            binary
*.jpg            binary
*.jpeg           binary
*.webp           binary
*.gif            binary
*.ico            binary
*.jar            binary
*.zip            binary
*.apk            binary
*.aab            binary
*.keystore       binary
*.jks            binary
*.so             binary
*.mp3            binary
*.mp4            binary

# Gradle wrapper 的 jar 不参与 diff
gradle/wrapper/gradle-wrapper.jar binary
